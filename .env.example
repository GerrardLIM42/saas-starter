# ---- Database ----
# 로컬 개발: docker run --name saas-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_dev"

# ---- Auth.js (NextAuth) ----
# 생성: npx auth secret  (또는 openssl rand -base64 32)
AUTH_SECRET="replace-with-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# ---- Stripe ----
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# https://dashboard.stripe.com/test/products 에서 등급별 월간/연간 Price와
# 크레딧 팩 Price를 만든 뒤 아래에 채워넣으세요. (Plan 테이블 seed와 값 일치 필요)
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_CREDITS_1000="price_..."

# ---- OpenAI ----
# 절대 클라이언트에 노출하지 말 것. 서버(API Route)에서만 사용.
OPENAI_API_KEY="sk-..."

# ---- MORIVA 스튜디오 (/studio, moriva-coupang-studio에서 이식) ----
# 비워두면 코드 기본값(gpt-5.6 / gpt-image-2) 사용. 실제 계정에서 쓸 수 있는 모델로 맞추세요.
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# ---- (선택) 스튜디오 클라우드 저장 - Supabase ----
# 설정하지 않으면 "클라우드 저장" 기능만 비활성화되고 나머지는 정상 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_OWNER_EMAIL=
